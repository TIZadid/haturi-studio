---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getProducts } from '../lib/products';

// every product's photos, interleaved so no two neighbours are the same piece
const products = await getProducts();
const lists = products.map((p) =>
  [{ src: p.data.hero, alt: p.data.heroAlt }, ...p.data.gallery].map((g) => ({ ...g, href: `/products/${p.id}`, name: p.data.name })),
);
const tiles: { src: ImageMetadata; alt: string; href: string; name: string }[] = [];
for (let i = 0; tiles.length < 12 && lists.some((l) => l[i]); i++) for (const l of lists) if (l[i] && tiles.length < 12) tiles.push(l[i]);
// asymmetric spans, repeating: [columns, rows, scroll speed]
const pattern: [number, number, number][] = [[2, 3, -0.06], [1, 2, 0.1], [1, 3, -0.03], [1, 2, 0.08], [2, 2, -0.08], [1, 3, 0.05]];
---
<section id="bento" class="section bento" data-ground="white" data-bento>
  <div class="wrap">
    <div class="bento__head">
      <p class="mono label" data-reveal>[In place] / {tiles.length} photos</p>
      <hr class="rule" data-reveal="rule" />
      <h2 class="h-section" data-reveal>Lived with.</h2>
    </div>
    <div class="bento__grid">
      {tiles.map((t, i) => {
        const [c, r, speed] = pattern[i % pattern.length];
        return (
          <a class="tile" href={t.href} style={`--c:${c};--r:${r}`} data-wide={c > 1 ? '' : undefined} data-bento-tile data-speed={speed} data-cursor="VIEW">
            <Picture src={t.src} alt={t.alt} widths={[400, 700, 1000]} sizes="(min-width: 900px) 30vw, 50vw" formats={['avif', 'webp']} />
            <span class="tile__name mono">{t.name} →</span>
          </a>
        );
      })}
    </div>
  </div>
</section>
<style>
  .bento__head { display: grid; gap: var(--space-4); margin-bottom: var(--space-8); }
  .bento__grid { display: grid; grid-template-columns: repeat(2, 1fr); grid-auto-rows: 120px; grid-auto-flow: dense; gap: var(--space-2); }
  /* phones: wide tiles span both columns, singles come in equal-height pairs, so the grid never leaves a hole */
  .tile { position: relative; overflow: clip; grid-column: span 1; grid-row: span 3; background: var(--color-dark); }
  .tile[data-wide] { grid-column: span 2; grid-row: span 2; }
  .tile :global(picture) { height: 100%; }
  .tile :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 1s var(--ease-out); }
  .tile:hover :global(img) { transform: scale(1.05); }
  .tile__name {
    position: absolute; left: var(--space-2); bottom: var(--space-2); padding: var(--space-1) var(--space-2);
    background: var(--scrim); color: var(--color-cream); font-size: 10px;
  }
  @media (min-width: 900px) {
    .bento__grid { grid-template-columns: repeat(4, 1fr); grid-auto-rows: 150px; gap: var(--space-4); }
    .tile, .tile[data-wide] { grid-column: span var(--c); grid-row: span var(--r); }
    .tile__name { opacity: 0; transform: translateY(6px); transition: opacity 0.3s, transform 0.3s var(--ease-out); left: var(--space-3); bottom: var(--space-3); }
    .tile:hover .tile__name { opacity: 1; transform: none; }
  }
</style>
<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { onPage } from '../scripts/motion/lifecycle';
  gsap.registerPlugin(ScrollTrigger);

  onPage(() => {
    const section = document.querySelector<HTMLElement>('[data-bento]');
    if (!section) return;
    const mm = gsap.matchMedia();
    // desktop only: tiles drift at different speeds while you scroll past; nothing is ever hidden
    mm.add('(min-width: 900px) and (prefers-reduced-motion: no-preference)', () => {
      // each photo drifts inside its own frame at its own speed: layered, and tiles never collide
      gsap.utils.toArray<HTMLElement>('[data-bento-tile]', section).forEach((tile) => {
        const speed = Number(tile.dataset.speed ?? 0);
        const img = tile.querySelector('img');
        if (!img) return;
        gsap.set(img, { scale: 1.25 });
        gsap.fromTo(img, { yPercent: speed * -120 }, {
          yPercent: speed * 120, ease: 'none',
          scrollTrigger: { trigger: tile, start: 'top bottom', end: 'bottom top', scrub: true },
        });
      });
    }, section);
    return () => mm.revert();
  });
</script>
