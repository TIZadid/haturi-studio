---
import { Image, Picture } from 'astro:assets';
import mark from '../assets/brand/mark-cream.png';
import DmButton from './DmButton.astro';
import { getProducts } from '../lib/products';
import { pad2 } from '../lib/format';
// every product gets a panel (up to three), so new pieces show up here on their own
const panels = (await getProducts()).slice(0, 3);
const lines = ['Haturi', 'Studio'];
---
<section id="top" class="hero" data-ground="dark" data-hero>
  <div class="hero__panels" style={`--n:${panels.length}`}>
    {panels.map((p, i) => (
      <a class="panel" href={`/products/${p.id}`} data-hero-panel data-cursor="VIEW">
        <div class="panel__media" data-hero-media>
          <Picture src={p.data.cover ?? p.data.hero} alt={p.data.heroAlt} widths={[480, 800, 1200, 1800]} sizes={`(min-width: 900px) ${Math.round(100 / panels.length) + 10}vw, ${Math.round(100 / panels.length)}vw`} formats={['avif', 'webp']} loading="eager" fetchpriority={i === 0 ? 'high' : 'auto'} />
        </div>
        <span class="panel__scrim" aria-hidden="true"></span>
        <span class="panel__label mono"><span class="panel__n">[{pad2(i + 1)}] </span>{p.data.name} <span class="panel__arrow" aria-hidden="true">→</span></span>
      </a>
    ))}
  </div>
  <div class="hero__band">
    <div class="wrap hero__block" data-hero-block>
      <div class="hero__brand">
      <Image src={mark} alt="" width={48} class="hero__mark" data-hero-mark />
      <h1 class="h-hero" aria-label="Haturi Studio">
        {lines.map((line) => (
          <span class="line" aria-hidden="true">{[...line].map((c) => <span class="char" data-hero-char>{c}</span>)}</span>
        ))}
      </h1>
      </div>
      <div class="hero__meta" data-hero-meta>
        <p class="mono">Minimal pieces for the things you keep / Handmade in Dhaka</p>
        <div class="hero__cta"><DmButton /></div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; height: 100svh; min-height: 620px; display: grid; grid-template-rows: 1fr auto; overflow: clip; }
  .hero__panels { display: flex; min-height: 0; }
  .panel { position: relative; flex: 1 1 0; overflow: clip; transition: flex-grow 0.8s var(--ease-out); }
  .panel__media, .panel__scrim { position: absolute; inset: 0; }
  .panel__media :global(picture) { height: 100%; }
  .panel__media :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease-out); }
  .panel__scrim { background: var(--scrim-light); transition: background 0.6s var(--ease-out); }
  .panel__label {
    position: absolute; left: var(--space-3); bottom: var(--space-3); z-index: 2; max-width: calc(100% - var(--space-6));
    padding: var(--space-1) var(--space-2); background: var(--scrim); color: var(--color-cream);
    font-size: 10px; letter-spacing: 0.12em; white-space: nowrap;
  }
  .panel__n { display: none; }
  .panel__arrow { display: inline-block; }
  .panel__arrow { transition: transform 0.4s var(--ease-out); }
  .panel:hover .panel__arrow { transform: translateX(6px); }
  .panel:hover .panel__media :global(img) { transform: scale(1.04); }
  .panel:hover .panel__scrim { background: transparent; }

  .hero__band { background: var(--color-dark); padding-block: var(--space-6) var(--space-8); }
  .hero__block { display: grid; gap: var(--space-4); justify-items: start; }
  .hero__brand { display: flex; align-items: center; gap: var(--space-4); }
  .hero__mark { height: 40px; width: auto; }
  h1 { color: var(--color-cream); text-transform: uppercase; font-size: clamp(44px, 11vw, 96px); }
  .line { display: inline-block; overflow: hidden; padding-bottom: 0.06em; }
  h1 { display: flex; flex-wrap: wrap; column-gap: 0.25em; }
  .char { display: inline-block; }
  .hero__meta { display: grid; gap: var(--space-4); }
  .hero__cta :global(.dm__label) { display: none; }

  @media (min-width: 900px) {
    .panel:hover { flex-grow: 1.35; }
    .panel__label { left: var(--gutter); bottom: var(--space-6); font-size: var(--text-mono); letter-spacing: var(--track-mono); }
    .panel__n { display: inline; }
    .hero__band { padding-block: var(--space-8); }
    .hero__block { display: flex; justify-content: space-between; align-items: end; gap: var(--space-8); }
    .hero__brand { flex: 0 0 auto; }
    .hero__meta { justify-items: end; text-align: right; max-width: 30rem; }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { onPage } from '../scripts/motion/lifecycle';

  onPage(() => {
    const hero = document.querySelector<HTMLElement>('[data-hero]');
    if (!hero) return;
    const mm = gsap.matchMedia();
    mm.add('(prefers-reduced-motion: no-preference)', () => {
      gsap.timeline({ defaults: { ease: 'expo.out' } })
        .from('[data-hero-panel]', { clipPath: 'inset(0% 0% 100% 0%)', duration: 1.1, stagger: 0.1, ease: 'expo.inOut' })
        .fromTo('[data-hero-mark]', { rotation: -40, transformOrigin: '75% 85%' }, { rotation: 8, duration: 0.3, ease: 'power3.in' }, '-=0.5')
        .to('[data-hero-mark]', { rotation: 0, duration: 0.9, ease: 'elastic.out(1, 0.35)' })
        .from('[data-hero-char]', { yPercent: 110, duration: 0.8, stagger: 0.025 }, '<0.05')
        .from('[data-hero-meta] > *', { autoAlpha: 0, y: 10, stagger: 0.08, duration: 0.6 }, '-=0.5');
    }, hero);
    return () => mm.revert();
  });
</script>
