<div class="cursor" data-cursor-ring aria-hidden="true" transition:persist><span class="mono"></span></div>
<style>
  .cursor {
    position: fixed; left: 0; top: 0; z-index: 70; pointer-events: none;
    padding: var(--space-1) var(--space-3); border-radius: var(--radius-pill);
    background: var(--color-ink-head); color: var(--color-cream);
    opacity: 0; transform-origin: 0 0; scale: 0.6;
    transition: opacity 0.18s, scale 0.18s var(--ease-out);
  }
  .cursor span { font-size: 10px; color: var(--color-cream); }
  .cursor[data-active] { opacity: 1; scale: 1; }
</style>
