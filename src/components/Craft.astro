---
import { Picture } from 'astro:assets';
import log from '../assets/craft/01-log.jpg';
import plank from '../assets/craft/02-plank.jpg';
import drawing from '../assets/craft/drawing.png';
import piece from '../assets/craft/04-piece.jpg';
const steps = [
  { src: log, n: '01', title: 'Log.', body: 'It starts as a log.', alt: 'Timber logs in low tungsten light.' },
  { src: plank, n: '02', title: 'Plank.', body: 'Cut into planks.', alt: 'Planks leaning against a brick wall in the workshop.' },
  { src: drawing, n: '03', title: 'Drawing.', body: 'Drawn before anything is cut.', alt: 'Pencil line drawing of the Medal Hanger.', paper: true },
  { src: piece, n: '04', title: 'Piece.', body: 'Joined and finished by hand.', alt: 'A finished Grid Shelf full of cups on a counter.' },
];
---
<section id="craft" class="section" data-ground="cream" data-craft>
  <div class="wrap craft fit">
    <div class="craft__head">
      <p class="mono label" data-reveal>[The craft] / Notes from the workshop</p>
      <hr class="rule" data-reveal="rule" />
      <h2 class="wordmark craft__title" data-reveal>Haturi means hammer.</h2>
      <hr class="rule" data-reveal="rule" />
    </div>
    <ol class="craft__steps" role="list">
      {steps.map((s) => (
        <li class="step" data-step-craft>
          <div class:list={['step__media', { 'step__media--paper': s.paper }]}>
            <Picture src={s.src} alt={s.alt} widths={[400, 800, 1200]} sizes="(min-width: 900px) 22vw, 46vw" formats={['avif', 'webp']} />
          </div>
          <span class="mono label">{s.n}</span>
          <h3 class="step__title">{s.title}</h3>
          <p class="step__body">{s.body}</p>
        </li>
      ))}
    </ol>
    <div class="craft__foot">
      <p class="mono label">One at a time / Dhaka</p>
      <p class="lede">Every piece is cut, joined and finished by hand in Dhaka, one at a time. Nothing comes off a production line.</p>
    </div>
  </div>
</section>
<style>
  .craft { display: grid; gap: var(--space-12); }
  .craft__head { display: grid; gap: var(--space-6); }
  .craft__title { font-size: min(160px, 12cqi); }
  .craft__steps { list-style: none; display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-8) var(--space-4); }
  .step { display: grid; gap: var(--space-2); align-content: start; }
  .step__media { overflow: clip; margin-bottom: var(--space-3); background: var(--color-dark); }
  /* the pencil drawing sits on warm kraft paper so it matches the tungsten photos beside it */
  .step__media--paper { background: var(--color-accent-2-300); }
  .step__media--paper :global(img) { mix-blend-mode: multiply; filter: contrast(1.15); }
  .step__media :global(img) { aspect-ratio: 3 / 4; object-fit: cover; width: 100%; transition: transform 1s var(--ease-out); }
  .step__media--paper :global(img) { object-fit: contain; padding: var(--space-4); }
  .step:hover .step__media :global(img) { transform: scale(1.05); }
  .step__title { font-size: 28px; }
  .step__body { color: var(--color-text); }
  .craft__foot { display: grid; gap: var(--space-4); padding-top: var(--space-6); border-top: 1px solid var(--hairline); }
  @media (min-width: 900px) {
    .craft__steps { grid-template-columns: repeat(4, 1fr); gap: var(--space-6); }
    .craft__foot { grid-template-columns: 1fr 1fr; }
  }
</style>
<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { onPage } from '../scripts/motion/lifecycle';
  gsap.registerPlugin(ScrollTrigger);

  onPage(() => {
    const root = document.querySelector<HTMLElement>('[data-craft]');
    if (!root) return;
    const mm = gsap.matchMedia();
    mm.add('(prefers-reduced-motion: no-preference)', () => {
      // plays once on arrival at a fixed pace, so you see the whole sequence without scrolling it away
      gsap.from('[data-step-craft] .step__media', {
        clipPath: 'inset(100% 0% 0% 0%)', duration: 0.9, ease: 'expo.out', stagger: 0.12,
        scrollTrigger: { trigger: '.craft__steps', start: 'top 85%', once: true },
      });
    }, root);
    return () => mm.revert();
  });
</script>
