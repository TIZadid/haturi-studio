---
import { Image, Picture } from 'astro:assets';
import mark from '../assets/brand/mark-cream.png';
import DmButton from './DmButton.astro';
import { getProducts } from '../lib/products';
import { pad2 } from '../lib/format';
// every product gets a panel (up to three), so new pieces show up here on their own
const panels = (await getProducts()).slice(0, 3);
const lines = ['Haturi', 'Studio'];
---
<section id="top" class="hero" data-ground="dark" data-hero>
  <div class="hero__panels">
    {panels.map((p, i) => (
      <a class="panel" href={`/products/${p.id}`} data-hero-panel data-cursor="VIEW">
        <div class="panel__media" data-hero-media>
          <Picture src={p.data.cover ?? p.data.hero} alt={p.data.heroAlt} widths={[480, 800, 1200, 1800]} sizes={`(min-width: 900px) ${Math.round(100 / panels.length) + 10}vw, ${Math.round(100 / panels.length)}vw`} formats={['avif', 'webp']} loading="eager" fetchpriority={i === 0 ? 'high' : 'auto'} />
        </div>
        <span class="panel__scrim" aria-hidden="true"></span>
        <span class="panel__label mono"><span class="panel__rule" aria-hidden="true"></span><span class="panel__n">[{pad2(i + 1)}] </span>{p.data.name}<span class="panel__aud"> / {p.data.audience}</span> <span class="panel__arrow" aria-hidden="true">→</span></span>
      </a>
    ))}
  </div>
  <div class="hero__block" data-hero-block>
    <Image src={mark} alt="" width={56} class="hero__mark hammer" data-hero-mark />
    <h1 class="h-hero" aria-label="Haturi Studio">
      {lines.map((line) => (
        <span class="line" aria-hidden="true">{[...line].map((c) => <span class="char" data-hero-char>{c}</span>)}</span>
      ))}
    </h1>
    <hr class="rule hero__rule" data-hero-rule />
    <div class="hero__meta" data-hero-meta>
      <p class="mono">Minimal pieces for the things you keep</p>
      <p class="mono">Handmade in Dhaka</p>
      <div class="hero__cta"><DmButton /></div>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; height: 100svh; min-height: 620px; overflow: clip; }
  .hero__panels { position: absolute; inset: 0; display: flex; }
  .panel { position: relative; flex: 1 1 0; overflow: clip; transition: flex-grow 0.8s var(--ease-out); }
  .panel__media, .panel__scrim { position: absolute; inset: 0; }
  .panel__media :global(picture) { height: 100%; }
  .panel__media :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease-out); }
  .panel__scrim { background: var(--scrim); transition: opacity 0.6s var(--ease-out); }
  .panel__label {
    position: absolute; left: var(--space-3); bottom: var(--space-4); z-index: 2; max-width: calc(100% - var(--space-6));
    display: flex; align-items: center; gap: var(--space-2); white-space: nowrap;
    color: var(--color-cream); font-size: 10px; letter-spacing: 0.12em;
  }
  .panel__rule, .panel__n, .panel__aud { display: none; }
  .panel__rule { width: 32px; border-top: 1px solid var(--hairline-dark); transition: width 0.6s var(--ease-out); }
  .panel__arrow { transition: transform 0.4s var(--ease-out); }
  .panel:hover .panel__rule { width: 64px; }
  .panel:hover .panel__arrow { transform: translateX(6px); }
  .panel:hover .panel__media :global(img) { transform: scale(1.04); }
  .panel:hover .panel__scrim { opacity: 0.55; }

  .hero__block {
    position: absolute; inset: 0; z-index: 3; pointer-events: none;
    display: grid; place-content: center; justify-items: center; gap: var(--space-4);
    padding-inline: var(--gutter); text-align: center;
  }
  .hero__mark { height: 52px; width: auto; pointer-events: auto; }
  h1 { display: grid; justify-items: center; color: var(--color-cream); text-transform: uppercase; }
  .line { display: block; overflow: hidden; padding-bottom: 0.06em; }
  .char { display: inline-block; }
  .hero__rule { width: 120px; }
  .hero__meta { display: grid; justify-items: center; gap: var(--space-2); }
  .hero__cta { pointer-events: auto; margin-top: var(--space-4); }
  .hero__cta :global(.dm__label) { display: none; }

  @media (min-width: 900px) {
    .panel:hover { flex-grow: 1.3; }
    .panel__label { left: var(--gutter); bottom: var(--space-8); font-size: var(--text-mono); letter-spacing: var(--track-mono); }
    .panel__rule { display: block; }
    .panel__n, .panel__aud { display: inline; }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { onPage } from '../scripts/motion/lifecycle';
  gsap.registerPlugin(ScrollTrigger);

  onPage(() => {
    const hero = document.querySelector<HTMLElement>('[data-hero]');
    if (!hero) return;
    const mm = gsap.matchMedia();
    mm.add('(prefers-reduced-motion: no-preference)', () => {
      gsap.timeline({ defaults: { ease: 'expo.out' } })
        .from('[data-hero-panel]', { clipPath: 'inset(50% 0% 50% 0%)', duration: 1.2, stagger: 0.12, ease: 'expo.inOut' })
        .fromTo('[data-hero-mark]', { rotation: -40, transformOrigin: '75% 85%' }, { rotation: 8, duration: 0.3, ease: 'power3.in' }, '-=0.5')
        .to('[data-hero-mark]', { rotation: 0, duration: 0.9, ease: 'elastic.out(1, 0.35)' })
        .from('[data-hero-rule]', { scaleX: 0, duration: 0.8 }, '<')
        .from('[data-hero-char]', { yPercent: 110, duration: 0.9, stagger: 0.03 }, '<0.05')
        .from('[data-hero-meta] > *', { autoAlpha: 0, y: 12, stagger: 0.08, duration: 0.7 }, '-=0.6');
      // gentle parallax; the title lifts away as the hero scrolls out
      gsap.to('[data-hero-media]', { yPercent: 8, ease: 'none', scrollTrigger: { trigger: hero, start: 'top top', end: 'bottom top', scrub: true } });
      gsap.to('[data-hero-block]', { yPercent: -18, autoAlpha: 0, ease: 'none', scrollTrigger: { trigger: hero, start: '20% top', end: '75% top', scrub: true } });
    }, hero);
    return () => mm.revert();
  });
</script>
